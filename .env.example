APP_ENV=development
APP_NAME=NaijaMobile AI
LOG_LEVEL=INFO
DATABASE_URL=postgresql://postgres:password@localhost:5432/naijamobile
PRICE_FRESHNESS_DAYS=7
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Configure these only when implementing the WhatsApp integration.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-value
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=vXX.X

# Hosted model provider — choose and verify current pricing/limits before use.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Optional operational controls
MAX_CONTEXT_MESSAGES=12
CUSTOMER_CONVERSATION_RETENTION_DAYS=90
CUSTOMER_PREFERENCE_RETENTION_DAYS=180
